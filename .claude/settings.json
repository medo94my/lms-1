{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected.sh",
            "statusMessage": "Checking protected paths..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.sh",
            "statusMessage": "Formatting edited file..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-related-on-edit.sh",
            "statusMessage": "Running related Vitest specs..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose -f compose.yml -f compose.preview.yml ps:*)",
      "Bash(docker compose -f compose.yml -f compose.preview.yml logs:*)",
      "Bash(docker compose -f compose.yml -f compose.preview.yml restart lms-preview)",
      "Bash(docker logs:*)"
    ]
  }
}
